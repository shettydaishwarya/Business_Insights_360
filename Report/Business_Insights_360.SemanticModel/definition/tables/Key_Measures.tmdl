table Key_Measures
	lineageTag: fe1608f4-2d1b-4e71-a9e3-b3318645fe89

	measure gross_sales($) = SUM(Facts_Actuals_Estimate[gross_sales_amount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: daac42c3-af81-4936-9171-274a5b980e82

	measure net_invoice_sales($) = SUM(Facts_Actuals_Estimate[net_invoice_sales_amount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 478748a5-0d66-4f5c-b7f3-7b6f46555543

	measure pre_invoice_deduction = [gross_sales($)]-[net_invoice_sales($)]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 50a5c793-f95b-4fae-8688-e6d49c9018ef

	measure post_invoice_deduction = SUM(Facts_Actuals_Estimate[post_invoice_deduction_amount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b3652a17-52c7-4551-806a-4bcd299bcdd0

	measure post_invoice_other_deductions = SUM(Facts_Actuals_Estimate[post_invoice_other_deduction_amount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 5bb2fca1-d846-4824-b5af-e3eb0f09cab1

	measure total_post_invoice_deduction($) = [post_invoice_deduction]+[post_invoice_other_deductions]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 022fb742-5f69-4709-916f-cfcb0e3c2100

	measure 'NS $' = SUM(Facts_Actuals_Estimate[net_sales])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 74c4ed7d-5261-4a00-9166-1ac16ed9de74

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure manufacturing_cost($) = SUM(Facts_Actuals_Estimate[manufacturing_cost])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 538d811d-3fee-4a0d-b496-77e79943a151

	measure freight_cost($) = SUM(Facts_Actuals_Estimate[freight_cost])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: a1137a68-d524-4ded-87b5-461d3d7342b2

	measure other_cost($) = SUM(Facts_Actuals_Estimate[freight_other_cost])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: e2124e7a-94b1-47bd-beb1-bb2aac948f85

	measure total_cogs($) = [manufacturing_cost($)]+[freight_cost($)]+[other_cost($)]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: c4b6e9c0-8d5d-492c-b59c-09803b8ea8d3

	measure 'GM $' = [NS $]-Key_Measures[total_cogs($)]
		lineageTag: bc8e1f4b-37d6-466c-b85d-a500494240a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'GM %' = DIVIDE([GM $],[NS $],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1efde86d-efbf-444d-93f8-169e4a13f60f

	measure Qty = SUM(Facts_Actuals_Estimate[Qty])
		formatString: 0
		lineageTag: ba6dc326-196d-472a-9914-3e8c210b149c

	measure GM/Unit = DIVIDE([GM $],[Qty],0)
		lineageTag: cb6a1679-e597-4dfb-8c52-41034ad022d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'P&L Values' =
			
			var res= SWITCH(
			TRUE(),
			MAX('P&L Rows'[Order]) =1, [gross_sales($)]/1000000,
			MAX('P&L Rows'[Order])  =2, [pre_invoice_deduction]/1000000,
			MAX('P&L Rows'[Order])  =3, [net_invoice_sales($)]/1000000,
			MAX('P&L Rows'[Order])  =4, [post_invoice_deduction]/1000000,
			MAX('P&L Rows'[Order]) =5, [post_invoice_other_deductions]/1000000,
			MAX('P&L Rows'[Order])=6,[post_invoice_deduction]/1000000+[post_invoice_other_deductions]/1000000,
			MAX('P&L Rows'[Order])  =7, [NS $]/1000000,
			MAX('P&L Rows'[Order]) =8, [manufacturing_cost($)]/1000000,
			MAX('P&L Rows'[Order])  =9, [freight_cost($)]/1000000,
			MAX('P&L Rows'[Order])  =10, [other_cost($)]/1000000,
			MAX('P&L Rows'[Order])  =11,[total_cogs($)]/1000000,
			MAX('P&L Rows'[Order]) =12, [GM $]/1000000,
			MAX('P&L Rows'[Order]) =13, [GM %]*100,
			MAX('P&L Rows'[Order]) =14, [GM/Unit],
			MAX('P&L Rows'[Order])=15, [Operational_expense($)]/1000000,
			MAX('P&L Rows'[Order]) =16, [Net Profit $]/1000000,
			MAX('P&L Rows'[Order]) = 17, [Net Profit %]*100)
			
			RETURN
			IF(HASONEVALUE('P&L Rows'[Description]),res,[NS $]/1000000)
		formatString: 0
		lineageTag: 5eb9ca08-38b6-4e21-8b8c-9a6e2e2aa1bd

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'P&L LY' = CALCULATE([P&L Values],SAMEPERIODLASTYEAR(dim_date[date]))
		lineageTag: 3557a157-98f9-4fec-9fd1-f2db92a84263

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'P & L Chg' =
			
			
			var res = [P&L Values]-[P & L BM]
			
			return IF(ISBLANK([P & L BM]) || ISBLANK([P&L Values]), BLANK(), res)
		lineageTag: e2ed9e40-e27c-4ae5-8d4d-71a4c7a87bf6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'P&L Chg %' =
			
			var res = DIVIDE([P & L Chg], ABS([P & L BM]),0)*100
			return
			IF(ISBLANK([P & L BM]) || ISBLANK([P&L Values]),BLANK(),RES)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e99728c6-8916-495d-b14a-c02a771b6f5b

	measure 'P&L Final Value' =
			SWITCH(TRUE(),
			SELECTEDVALUE(Fiscal_Year[FY_desc])=MAX('P&L Columns'[Col Header]),[P&L Values],
			MAX('P&L Columns'[Col Header])="BM" ,[P & L BM],
			MAX('P&L Columns'[Col Header])="Chg", [P & L Chg],
			MAX('P&L Columns'[Col Header])="Chg %", [P&L Chg %])
		lineageTag: 2da46d87-0524-42cb-b0dd-80fdf6b4bd13

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'selected P&L row' = IF(HASONEVALUE('P&L Rows'[Description]),SELECTEDVALUE('P&L Rows'[Description]),"Net_Sales")
		lineageTag: 2872931a-a6e9-48db-b7f3-bb023b6a53a8

	measure 'performance over time visual' = [selected P&L row] & " Performance Over Time"
		lineageTag: e5dd178c-58b8-4b48-9094-70527f55f4f3

	measure 'ads & promotions($)' = SUM(Facts_Actuals_Estimate[ads_promotion])
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: 17965547-83bf-4996-8eca-140d744daf7a

