	measure other_operational_expenses($) = SUM(Facts_Actuals_Estimate[other_operational_expense])
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: a9a2d810-7528-4464-ad87-94c460791e4b

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure Operational_expense($) = ([ads & promotions($)]+[other_operational_expenses($)])*-1
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: 20a2039c-eb3c-4975-9b8c-3038c804f319

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'Net Profit $' = [GM $]+[Operational_expense($)]
		lineageTag: 545fe1e9-b9ff-416e-8ccd-4134827cbb12

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Profit %' = DIVIDE([Net Profit $],[NS $],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4bcaad01-0bab-42ff-90fd-7551e8cc6656

	measure Sales_Qty = CALCULATE([Qty],Facts_Actuals_Estimate[date]<=MAX(Last_Sales_Month[Last_Sales_Month]))
		formatString: 0
		lineageTag: ee6a0aaf-b674-4572-9a71-c73989a14065

	measure forecast_qty =
			
			var lsalesdate=MAX(Last_Sales_Month[Last_Sales_Month])
			RETURN
			CALCULATE(SUM(fact_forecast_monthly[forecast_quantity]),fact_forecast_monthly[date]<=lsalesdate)
		formatString: 0
		lineageTag: 4ab60247-e22f-4795-8d86-d664465ee49a

	measure 'Net Error' = [forecast_qty]-[Sales_Qty]
		formatString: 0
		lineageTag: 8d50ff8f-232a-4f9f-a0f7-787ccc513399

	measure 'Net Error %' = DIVIDE([Net Error],[forecast_qty],0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a3d359db-d66b-45c3-9d47-281f057e2d30

	measure 'ABS Error' =
			
			SUMX(DISTINCT(dim_date[Month]),
			SUMX(DISTINCT(dim_product),ABS([Net Error])))
		formatString: 0
		lineageTag: d548d171-8b51-476c-83b7-bbef4e813918

	measure 'ABS Error %' = DIVIDE([ABS Error],[forecast_qty],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 620473d4-b995-4a1c-be2a-88ef722d239d

	measure 'Forecast Accuracy %' = if([ABS Error %]<>BLANK(),1-[ABS Error %],BLANK())
		formatString: 0.00%;-0.00%;0.00%
