	measure 'net sales before forecast' =
			
			var lastsalesdate = MAX(fact_sales_monthly[date])
			var forecaststartdate = DATE(YEAR(lastsalesdate),MONTH(lastsalesdate)+1, DAY(lastsalesdate))
			RETURN
			CALCULATE([NS $], FILTER(dim_date,dim_date[date]<=forecaststartdate))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: d3710122-6d8e-4758-b349-a93df0401149

	measure 'net sales forecast' =
			
			CALCULATE([NS $], FILTER(dim_date,dim_date[date]>MAX(fact_sales_monthly[date])))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 4c4d4f7e-9e0a-49f5-95e5-73317f700306

	measure forecaststartdate =
			
			var lastsalesdate = MAX(fact_sales_monthly[date])
			var forecaststartdate = DATE(YEAR(lastsalesdate),MONTH(lastsalesdate)+1,DAY(lastsalesdate))
			RETURN
			forecaststartdate
		formatString: General Date
		lineageTag: 922d9cd8-999c-4a51-98bd-f802aa03dc65

	measure 'Forecast area BG' =
			
			VAR _max= MAXX(ALL(dim_date[month]),[NS $])
			VAR _limitmultiplayer= 2
			VAR _Maxlimit= _max*_limitmultiplayer
			RETURN
			IF(max(dim_date[date])>=[forecaststartdate], _Maxlimit, BLANK())
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: 5191fd74-d94d-4cee-9544-57a418f56ffb

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'Min NS$' =
			
			VAR _overallmin= CALCULATE(MINX(dim_date, [NS $]),dim_date[month])
			RETURN
			If([NS $]= _overallmin, [NS $],BLANK())
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 12e09dc1-060f-419a-a129-a0362e45fc4a

	measure 'Max NS$' =
			
			VAR _overallmax= CALCULATE(MAXX(dim_date,[NS $]),dim_date[month])
			RETURN
			If([NS $]= _overallmax, [NS $],BLANK())
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: e9ecc2bc-eaf9-4bc4-92e7-fc05911880e8

	measure 'Last Month NS$' =
			
