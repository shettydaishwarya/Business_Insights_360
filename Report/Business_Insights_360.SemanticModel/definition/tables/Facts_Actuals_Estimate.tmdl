	column post_invoice_deduction_amount = ```
			
			var res = CALCULATE(MAX(post_invoice_deductions[discounts_pct]), 
			RELATEDTABLE(post_invoice_deductions))
			RETURN res*Facts_Actuals_Estimate[net_invoice_sales_amount]
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7c2e8497-0640-4c2c-bac8-14a7968a9567
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column post_invoice_other_deduction_amount = ```
			
			var res = CALCULATE(MAX(post_invoice_deductions[other_deductions_pct]), 
			RELATEDTABLE(post_invoice_deductions))
			RETURN res*Facts_Actuals_Estimate[net_invoice_sales_amount]
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ab879c07-7008-4bc3-a136-8f19a8f39694
