	column net_sales = Facts_Actuals_Estimate[net_invoice_sales_amount]-Facts_Actuals_Estimate[post_invoice_deduction_amount]-Facts_Actuals_Estimate[post_invoice_other_deduction_amount]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
