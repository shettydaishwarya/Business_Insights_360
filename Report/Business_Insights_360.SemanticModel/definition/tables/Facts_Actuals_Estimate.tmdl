	column manufacturing_cost =
			
			var res=CALCULATE(MAX(manufacturing_cost[manufacturing_cost]),RELATEDTABLE(manufacturing_cost))
			RETURN res*Facts_Actuals_Estimate[Qty]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: a69acd98-c33c-44eb-82b7-42469f1efe40
