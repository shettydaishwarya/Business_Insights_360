	column other_operational_expense =
			
			var res = CALCULATE(MAX(Operational_Expense[other_operational_expense_pct]),
			RELATEDTABLE(Operational_Expense))
			RETURN res*Facts_Actuals_Estimate[net_sales]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
