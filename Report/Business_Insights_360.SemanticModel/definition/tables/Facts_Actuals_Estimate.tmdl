			RELATEDTABLE(freight_cost))
			RETURN res*Facts_Actuals_Estimate[net_sales]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 72fa0b49-ad5f-48e0-b7b7-253e821be8b6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ads_promotion =
			
			var res = CALCULATE(MAX(Operational_Expense[ads_promotions_pct]),
			RELATEDTABLE(Operational_Expense))
			RETURN res*Facts_Actuals_Estimate[net_sales]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 855e8f55-4dd2-4ef9-9b25-662c64d6e2f8
		summarizeBy: sum

