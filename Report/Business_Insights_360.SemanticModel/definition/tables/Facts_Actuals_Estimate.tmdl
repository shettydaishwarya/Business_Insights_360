	column freight_cost =
			
			var res = CALCULATE(MAX(freight_cost[freight_pct]),
			RELATEDTABLE(freight_cost))
			RETURN res*Facts_Actuals_Estimate[net_sales]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 098ffad5-8968-4c56-8aa3-63c9a89fdfc1
