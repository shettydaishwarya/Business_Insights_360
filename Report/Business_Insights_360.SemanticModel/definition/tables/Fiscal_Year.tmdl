table Fiscal_Year
	lineageTag: d2002f88-cd37-4c75-8bc2-79f6d1ca5d4a

	column 'Fiscal Year'
		lineageTag: 40446330-083f-419e-8e28-5b37d3f5a4ca
		summarizeBy: none
		isNameInferred
		sourceColumn: dim_date[Fiscal Year]

		annotation SummarizationSetBy = Automatic

	column FY_desc =
			
			var MaxDate = CALCULATE(MAX(Fiscal_Year[Fiscal Year]),ALL(Fiscal_Year[Fiscal Year]))
			RETURN
			IF(Fiscal_Year[Fiscal Year]=MaxDate, MaxDate & " est", Fiscal_Year[Fiscal Year])
		lineageTag: 3862e3b2-65b8-46a1-b82f-3eb4fbdfab77
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Fiscal_Year = calculated
		mode: import
		source = ALLNOBLANKROW(dim_date[Fiscal Year])

	annotation PBI_Id = 025ae8db46864ba291dee7bb55021957

